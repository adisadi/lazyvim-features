{
  "id": "claude-code",
  "version": "1.0.3",
  "name": "Claude Code",
  "documentationURL": "https://github.com/adisadi/lazyvim-features",
  "description": "Installs Claude Code CLI (standalone, no Node.js required) and mounts host ~/.claude for authentication",
  "options": {},
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.claude",
      "target": "/home/vscode/.claude"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.claude.json",
      "target": "/home/vscode/.claude.json"
    }
  ],
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils"
  ]
}
