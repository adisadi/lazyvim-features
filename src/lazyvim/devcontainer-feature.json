{
  "id": "lazyvim",
  "version": "1.0.3",
  "name": "LazyVim",
  "documentationURL": "https://github.com/adisadi/lazyvim-features",
  "description": "Installs Neovim with LazyVim dependencies (ripgrep, fd, fzf, lazygit, clipboard support)",
  "options": {
    "version": {
      "type": "string",
      "proposals": [
        "stable",
        "nightly"
      ],
      "default": "stable",
      "description": "Neovim version to install"
    },
    "configRepo": {
      "type": "string",
      "default": "",
      "description": "Git repository URL to clone as nvim config (e.g., https://github.com/user/nvim-config)"
    },
    "locale": {
      "type": "string",
      "default": "en_US.UTF-8",
      "description": "UTF-8 locale to generate and set (e.g., de_CH.UTF-8, en_GB.UTF-8)"
    }
  },
  "mounts": [
    "source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=/tmp/${localEnv:WAYLAND_DISPLAY},type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "containerEnv": {
    "EDITOR": "nvim",
    "VISUAL": "nvim",
    "XDG_RUNTIME_DIR": "/tmp"
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils"
  ]
}
